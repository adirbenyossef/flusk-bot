# Local Development Configuration
# Copy this to .env.local: cp .env.local.example .env.local

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Local MongoDB (via docker-compose)
MONGODB_URI=mongodb://localhost:27017/agent-platform

# LLM - Choose one option:

# Option 1: OpenRouter (requires API key from https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...

# Option 2: Ollama (local, free) - run: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# USE_OLLAMA=true

# Option 3: Mock mode (no LLM, returns test responses)
USE_MOCK_LLM=true

# Slack (optional - skip for initial testing)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_APP_TOKEN=xapp-...

# WhatsApp (optional - skip for initial testing)
# WA_ACCESS_TOKEN=...
# WA_VERIFY_TOKEN=...
# WA_PHONE_NUMBER_ID=...
